{
  "global_tags": {
    "CostControl": "Ignore",
    "SecurityControl": "Ignore"
  },
  "environment_name": "${AZURE_ENV_NAME}",
  "location": "${AZURE_LOCATION}",
  "subscription_id": "${AZURE_SUBSCRIPTION_ID}",
  "data_plane_location": "${DISCOVERY_DATA_PLANE_LOCATION=}",
  "vnet_address_prefix": "${DISCOVERY_VNET_ADDRESS_PREFIX=10.0.0.0/16}",
  "storage_replication_type": "${DISCOVERY_STORAGE_REPLICATION=GRS}",
  "node_pool": {
    "vm_size": "${DISCOVERY_VM_SIZE=Standard_D4s_v6}",
    "min_node_count": "${DISCOVERY_MIN_NODES=0}",
    "max_node_count": "${DISCOVERY_MAX_NODES=3}",
    "scale_set_priority": "${DISCOVERY_NODE_PRIORITY=Regular}"
  },
  "chat_model": {
    "name": "${DISCOVERY_CHAT_MODEL=gpt-5.4}",
    "deployment_name": "${DISCOVERY_CHAT_DEPLOYMENT=gpt-5-4}"
  },
  "workspace_features": {
    "enable_ghcp_ai_features": "${DISCOVERY_ENABLE_GHCP_AI=true}",
    "enable_extensions": "${DISCOVERY_ENABLE_EXTENSIONS=true}",
    "network_isolation": "${DISCOVERY_NETWORK_ISOLATION=true}"
  }
}