tcoupl = V-rescale
tc-grps = System
tau_t = 0.1
ref_t = 300
pcoupl = no
gen_vel = yes
gen_temp = 300
gen_seed = 20261008
nstenergy = 500
nstlog = 500
nstxout-compressed = 500
nstxout = 0
nstvout = 0
nstfout = 0