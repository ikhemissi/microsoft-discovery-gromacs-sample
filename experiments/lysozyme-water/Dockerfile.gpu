FROM docker.io/nvidia/cuda:12.6.3-devel-ubuntu24.04 AS builder

ARG BUILD_JOBS=2
ARG CUDA_TARGET_SM="80;90"
RUN apt-get update \
	&& apt-get install -y --no-install-recommends build-essential cmake curl ca-certificates libfftw3-dev \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN curl --fail --location --proto '=https' --proto-redir '=https' \
		--retry 3 --connect-timeout 15 --max-time 300 \
		https://ftp.gromacs.org/pub/gromacs/gromacs-2025.2.tar.gz --output gromacs.tar.gz \
	&& printf '%s  gromacs.tar.gz\n' '0df09f9d45a99ef00e66b9baa9493a27e906813763a3b6c7672217c66b43ea11' | sha256sum --check --strict \
	&& tar -xzf gromacs.tar.gz \
	&& cmake -S gromacs-2025.2 -B gromacs-build \
		-DCMAKE_INSTALL_PREFIX=/opt/gromacs \
		-DCMAKE_BUILD_TYPE=Release \
		-DGMX_GPU=CUDA \
		-DGMX_CUDA_TARGET_SM="${CUDA_TARGET_SM}" \
		-DGMX_CUDA_TARGET_COMPUTE=90 \
		-DGMX_SIMD=AVX2_256 \
		-DGMX_MPI=OFF \
		-DGMX_THREAD_MPI=ON \
		-DGMX_OPENMP=ON \
		-DGMX_BUILD_OWN_FFTW=OFF \
	&& cmake --build gromacs-build --parallel "${BUILD_JOBS}" \
	&& cmake --install gromacs-build

FROM docker.io/nvidia/cuda:12.6.3-runtime-ubuntu24.04 AS base
RUN apt-get update \
	&& apt-get install -y --no-install-recommends curl ca-certificates libgomp1 libfftw3-single3 \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/gromacs /opt/gromacs
ENV PATH="/opt/gromacs/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/gromacs/lib:/opt/gromacs/lib64:${LD_LIBRARY_PATH}"
WORKDIR /opt/lysozyme-water
COPY run.sh *.mdp ./

FROM base AS discovery
RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 \
	&& rm -rf /var/lib/apt/lists/* \
	&& mkdir -p /app/workdir /input /output
WORKDIR /app/workdir
CMD ["/bin/bash"]

FROM base AS gpu
ENTRYPOINT ["bash", "/opt/lysozyme-water/run.sh"]